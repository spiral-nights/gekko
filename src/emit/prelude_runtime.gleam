  <> "///|\n"
  <> "pub fn BitArray::bits_segment(self : BitArray, bits : Int64) -> BitArray {\n"
  <> "  if bits <= 0L {\n"
  <> "    BitArray::empty()\n"
  <> "  } else if bits == self.bit_length {\n"
  <> "    self\n"
  <> "  } else {\n"
  <> "    match bit_array_read_bits(self, 0L, bits) {\n"
  <> "      Some(v) => v\n"
