  <> "/// Convert a Gleam `GList[T]` into a MoonBit `Array[T]`.\n"
  <> "pub fn[T] GList::to_array(self : GList[T]) -> Array[T] {\n"
  <> "  let out : Array[T] = []\n"
  <> "  for cur = self {\n"
  <> "    match cur {\n"
  <> "      Nil => break out\n"
  <> "      Cons(head, tail) => {\n"
  <> "        out.push(head)\n"
  <> "        continue tail\n"
  <> "      }\n"
  <> "    }\n"
  <> "  }\n"
  <> "}\n"
  <> "\n"
  <> "///|\n"
